DATABASE_URL=file:./storage/db/ibkama.db
# openssl rand -base64 48
SESSION_SECRET=
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
# HAPUS baris SUPERADMIN_* dari server setelah `npm run db:seed` dijalankan sekali; ganti password lewat /admin/akun.
SUPERADMIN_PASSWORD=

# --- Masuk dengan Google (opsional) ---
# Buat OAuth Client (tipe "Web application") di https://console.cloud.google.com/apis/credentials
# Authorized redirect URI yang harus didaftarkan:
#   http://localhost:3000/auth/google/callback        (pengembangan)
#   https://<domain-website>/auth/google/callback     (produksi)
# Bila kosong, tombol "Masuk dengan Google" otomatis disembunyikan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# WAJIB di produksi: alamat publik website (https://...). Dipakai untuk redirect URI Google, tautan QR presensi,
# dan tautan bukti pada ekspor CSV. Bila kosong, aplikasi memakai header Host/X-Forwarded-Host dari permintaan.
# Dibaca saat runtime (tidak perlu build ulang), mis. https://ibkama.example.org
NEXT_PUBLIC_SITE_URL=
